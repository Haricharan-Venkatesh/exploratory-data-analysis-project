{
  "model_name": "EDA Behavioral LightGBM Classifier",
  "model_type": "LightGBM (Gradient Boosted Decision Trees)",
  "version": "1.0.0",
  "date": "October 2026",
  "feature_set": "EDA_BEHAVIORAL_10",
  "features": [
    "consecutive_fast_moves",
    "premove_rate_10",
    "cumulative_premove_rate",
    "current_endgame_clock_ratio",
    "phase_deliberation_ratio",
    "move_time_cv_10",
    "time_pressure_jitter",
    "relative_move_time",
    "time_spent_ratio",
    "tank_move_count_10"
  ],
  "operating_threshold": 0.5,
  "test_metrics_unseen_game": {
    "roc_auc": 0.9008,
    "pr_auc": 0.478,
    "balanced_accuracy": 0.8134,
    "precision": 0.1845,
    "recall": 0.731,
    "f1_score": 0.2946
  },
  "training_strategy": {
    "class_weight": "balanced",
    "scale_pos_weight": 27.44,
    "grouping_variable": "game_id",
    "n_estimators": 150,
    "learning_rate": 0.05,
    "max_depth": 6
  }
}